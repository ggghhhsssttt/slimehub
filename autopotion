-- FAST STEAL GUI (SIMPLIFIED)
local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local player = Players.LocalPlayer

-- State
local autoPotionEnabled = false
local speedBoostEnabled = false
local autoKick = false
local unwalkEnabled = false
local currentSpeed = 32

-- UI References
local autoPotionBtn
local speedBtn
local kickBtn
local unwalkBtn

-- Speed Boost
local speedConnection
local function enableSpeed()
    if speedConnection then return end
    speedBoostEnabled = true
    speedConnection = RS.Heartbeat:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = currentSpeed
        end
    end)
    if speedBtn then
        speedBtn.Text = "Speed Boost [ON]"
        speedBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end
end

local function disableSpeed()
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
    speedBoostEnabled = false
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 16
    end
    if speedBtn then
        speedBtn.Text = "Speed Boost [OFF]"
        speedBtn.BackgroundColor3 = Color3.fromRGB(80, 0, 150)
    end
end

-- Activate Potion
local function activatePotion()
    local char = player.Character
    if not char then return end
    
    local bp = player.Backpack
    local tool = bp and bp:FindFirstChild("Giant Potion") or char:FindFirstChild("Giant Potion")
    
    if tool then
        if tool.Parent == bp then
            tool.Parent = char
            task.wait(0.1)
        end
        tool:Activate()
        task.wait(0.1)
        tool.Parent = bp
    end
end

-- Auto Potion System
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if not autoPotionEnabled then return end
    if prompt.ActionText ~= "Steal" then return end
    
    local holdTime = prompt.HoldDuration
    if holdTime <= 0.17 then return end
    
    local waitTime = holdTime - 0.17
    
    task.spawn(function()
        task.wait(waitTime)
        
        -- Enable speed boost automatically
        if not speedBoostEnabled then
            enableSpeed()
        end
        
        -- Activate potion
        activatePotion()
    end)
end)

